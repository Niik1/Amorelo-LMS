# Fase 0 — Variables de entorno. Copiar a .env.local y completar.
# NUNCA commitear valores reales (.env* está en .gitignore salvo este archivo).

# --- Sitio ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Solo servidor: nunca exponer en componentes cliente.
SUPABASE_SECRET_KEY=

# --- Mercado Pago ---
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# --- PayPal (API REST con fetch; sin SDK) ---
PAYPAL_ENV=sandbox # sandbox | live
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# --- Facturación electrónica SUNAT (API externa) ---
BILLING_API_URL=
BILLING_API_TOKEN=

# --- Correos (Resend) ---
RESEND_API_KEY=
EMAIL_FROM=

# --- Rate limiting (Upstash Redis) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Cloudflare Turnstile (anti-bots) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Cron (reconciliación de pagos y reintentos de facturación) ---
CRON_SECRET=


# --- Sentry (Monitoreo de errores y excepciones) ---
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
